@using KnowledgeAssistant.Application.DTOs.Dashboard
@using ApexCharts

<div class="monthly-chart">
    <ApexChart TItem="MonthlyCount"
               Options="@_options"
               Height="@Height"
               XAxisType="XAxisType.Category">

        <ApexPointSeries TItem="MonthlyCount"
                         Items="@ChartData"
                         Name="@SeriesName"
                         SeriesType="SeriesType.Bar"
                         XValue="@(d => d.Label)"
                         YValue="@(d => (decimal)d.Count)" />
    </ApexChart>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MonthlyCount> Data { get; set; } = Array.Empty<MonthlyCount>();

    [Parameter]
    public string SeriesName { get; set; } = "Chats";

    [Parameter]
    public string Height { get; set; } = "280px";

    private List<MonthlyCount> ChartData => Data.ToList();

    private ApexChartOptions<MonthlyCount> _options = new()
    {
        Chart = new Chart
        {
            Background = "transparent",
            Toolbar = new Toolbar
            {
                Show = false
            },
            Animations = new Animations
            {
                Enabled = false
            }
        },
        Theme = new Theme
        {
            Mode = Mode.Dark
        },
        Colors = new List<string> { "#5B8DEF" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                BorderRadius = 6,
                ColumnWidth = "42%"
            }
        },
        DataLabels = new DataLabels
        {
            Enabled = false
        },
        Grid = new Grid
        {
            BorderColor = "rgba(255,255,255,0.10)",
            StrokeDashArray = 4,
            Padding = new Padding
            {
                Left = 8,
                Right = 12
            }
        },
        Legend = new Legend
        {
            Show = false
        },
        Tooltip = new Tooltip
        {
            Enabled = true
        },
        Xaxis = new XAxis
        {
            Labels = new XAxisLabels
            {
                Style = new AxisLabelStyle
                {
                    Colors = "#B7C6DE",
                    FontSize = "12px"
                }
            },
            AxisBorder = new AxisBorder
            {
                Show = false
            },
            AxisTicks = new AxisTicks
            {
                Show = false
            }
        },
        Yaxis = new List<YAxis>
        {
            new()
            {
                Min = 0,
                ForceNiceScale = true,
                Labels = new YAxisLabels
                {
                    Style = new AxisLabelStyle
                    {
                        Colors = "#B7C6DE",
                        FontSize = "12px"
                    }
                }
            }
        }
    };
}
