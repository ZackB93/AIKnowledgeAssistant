@using KnowledgeAssistant.Application.Services
@using KnowledgeAssistant.Application.DTOs.Users
@using KnowledgeAssistant.Application.DTOs.Cache
@using System.ComponentModel.DataAnnotations

@if (Errored)
{
    <Error Text="An error occurred while loading profile!" />
}
else if(Loading)
{
    <LoadingSpinner Text="Please wait" />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4" Style=@(!AllowBorder ? "border: none;" : string.Empty)>
        @if (AllowBorder)
        {
            <MudText Typo="Typo.h5" Class="mb-4">Profile</MudText>
        }

        <MudForm @ref="_form" Model="_editModel" Validation="@(_validator.ValidateValue)">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Person">
                    <MudGrid Style="padding: 15px;">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editModel.FirstName"
                                          For="@(() => _editModel.FirstName)"
                                          Label="First Name"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editModel.LastName"
                                          For="@(() => _editModel.LastName)"
                                          Label="Last Name"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Value="_editModel.Email"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          ReadOnly="true" />
                        </MudItem>

                        @if(UserId != -1)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTextField Value="@_editModel.CreatedDateTime.ToString("dd/MM/yyyy")"
                                          Label="Created Date"
                                          Variant="Variant.Outlined"
                                          ReadOnly="true" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Address" Icon="@Icons.Material.Filled.Home">
                    <MudGrid Style="padding: 15px;">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_editModel.AddressLine1"
                                          For="@(() => _editModel.AddressLine1)"
                                          Label="Address Line 1"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_editModel.AddressLine2"
                                          Label="Address Line 2"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_editModel.AddressLine3"
                                          Label="Address Line 3"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editModel.Postcode"
                                          For="@(() => _editModel.Postcode)"
                                          Label="Postcode"
                                          Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editModel.Location"
                                          For="@(() => _editModel.Location)"
                                          Label="Location"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @if(UserId == -1)
                {
                     <MudTabPanel Text="Credentials" Icon="@Icons.Material.Filled.Key">
                        <MudGrid Style="padding: 15px;">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_editModel.Password"
                                              For="@(() => _editModel.Password)"
                                              InputType="@InputType.Password"
                                              Label="Password"
                                              Immediate="true"
                                              Variant="Variant.Outlined" />

                                <PasswordRequirements Password="@_editModel.Password" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_editModel.ReenterPassword"
                                              For="@(() => _editModel.ReenterPassword)"
                                              InputType="@InputType.Password"
                                              Label="Re-enter Password"
                                              Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                }
            </MudTabs>
        </MudForm>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@Saving">
                @if (Saving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Saving...</MudText>
                }
                else
                {
                    <MudText>Save</MudText>
                }
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
}

@code {
    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject]
    private ICacheService CacheService { get; set; } = null!;

    [Parameter]
    public int? UserId { get; set; }

    [Parameter]
    public bool AllowBorder { get; set; } = true;

    [Parameter]
    public EventCallback OnUserSaved { get; set; }

    private bool Errored = false;
    private bool Loading = false;
    private bool Saving = false;
    private UserResponse? User = null;
    private MudForm _form = null!;
    private UpdateUserRequest _editModel = new();
    private readonly UserProfileEditModelValidator _validator = new();

    protected override async Task OnInitializedAsync()
    {
        if (UserId != -1)
        {
            await LoadUserProfile();
        }
    }

    private async Task LoadUserProfile()
    {
        if (UserId is null)
        {
            Snackbar.Add("An error has occurred loading profile!", Severity.Error);
            Errored = true;
        }

        Loading = true;

        var Cache = new Cache() { CacheKey = $"UserProfile:{UserId}", CacheTimeMins = 5 };
        var Response = await HttpService.GetDataAsync($"/User/GetById/{UserId}", Cache);

        if (Response.IsSuccessful && Response.Data is not null)
        {
            User = Response.GetData<UserResponse>();
            _editModel = MapToEditModel(User!);
            Loading = false;
        }
        else
        {
            Snackbar.Add("An error has occurred loading profile!", Severity.Error);
            Errored = true;
        }
    }

    private static UpdateUserRequest MapToEditModel(UserResponse dto) => new()
    {
        Id = dto.Id,
        FirstName = dto.FirstName,
        LastName = dto.LastName,
        Email = dto.Email,
        CreatedDateTime = dto.CreatedDateTime,
        AddressLine1 = dto.AddressLine1,
        AddressLine2 = dto.AddressLine2 ?? string.Empty,
        AddressLine3 = dto.AddressLine3 ?? string.Empty,
        Postcode = dto.Postcode,
        Location = dto.Location
    };

    private static UserResponse MapToDto(UpdateUserRequest model, UserResponse original) => new()
    {
        Id = model.Id,
        FirstName = model.FirstName,
        LastName = model.LastName,
        Email = original.Email,
        AddressLine1 = model.AddressLine1,
        AddressLine2 = string.IsNullOrWhiteSpace(model.AddressLine2) ? null : model.AddressLine2,
        AddressLine3 = string.IsNullOrWhiteSpace(model.AddressLine3) ? null : model.AddressLine3,
        Postcode = model.Postcode,
        Location = model.Location,
        Enabled = original.Enabled,
        CreatedDateTime = original.CreatedDateTime,
        IsDeleted = original.IsDeleted
    };

    private async Task Save()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            Snackbar.Add("Please fix the highlighted fields.", Severity.Warning);
            return;
        }

        Saving = true;

        var NewUser = UserId == -1;
        var Endpoint = NewUser ? "/User/Create" : "/User/Update";
        var Response = await HttpService.PostDataAsync(Endpoint, _editModel);

        if (Response.IsSuccessful && Response.Data is not null)
        {
            User = MapToDto(_editModel, Response.GetData<UserResponse>()!);
            CacheService.RemoveFromCache($"UserProfile:{UserId}");

            if(NewUser)
            {
                UserId = User.Id;
            }

            await OnUserSaved.InvokeAsync();
            Snackbar.Add("Successfully saved!", Severity.Success);
        }
        else
        {
            Snackbar.Add("An error occurred whilst saving!", Severity.Error);
        }

        Saving = false;
    }

    private class UserProfileEditModelValidator
    {
        public IEnumerable<string> ValidateValue(object model)
        {
            var context = new ValidationContext(model);
            var results = new List<ValidationResult>();

            Validator.TryValidateObject(model, context, results, true);

            return results.Select(r => r.ErrorMessage ?? "Invalid value");
        }
    }
}
