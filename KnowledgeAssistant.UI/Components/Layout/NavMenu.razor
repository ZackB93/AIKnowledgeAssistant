@using Microsoft.AspNetCore.Components.Authorization

<MudDrawer @bind-Open="Open"
           Variant="DrawerVariant.Responsive"
           Elevation="0"
           Color="Color.Primary"
           Class="knowledge-drawer">

    <div class="d-flex flex-column" style="height: 100%;">
        <div class="d-flex align-center gap-2 pa-4 knowledge-logo-row">
            <MudImage Src="images/ai_head.png" Alt="Logo" Width="35" Height="35" />
            <MudText Typo="Typo.subtitle2" Class="knowledge-brand-name">Knowledge Assistant</MudText>
        </div>

        <MudNavMenu Class="knowledge-nav">
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat" IconColor="Color.Inherit">
                Chat
            </MudNavLink>

            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person" IconColor="Color.Inherit">
                My Profile
            </MudNavLink>

            <AuthorizeView Roles="Admin">
                 <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Inherit">

                    <MudNavLink Href="/admin/documents" Icon="@Icons.Material.Filled.Description" IconColor="Color.Inherit">
                        Documents
                    </MudNavLink>

                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.Person" IconColor="Color.Inherit">
                        Users
                    </MudNavLink>

                    <MudNavLink Href="/admin/emails" Icon="@Icons.Material.Filled.Email" IconColor="Color.Inherit">
                        Emails
                    </MudNavLink>

                    <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.Badge" IconColor="Color.Inherit">
                        Roles
                    </MudNavLink>

                    <MudNavLink Href="/admin/notifications" Icon="@Icons.Material.Filled.Badge" IconColor="Color.Inherit">
                        Notifications
                    </MudNavLink>

                </MudNavGroup>
            </AuthorizeView>
        </MudNavMenu>

        <div class="knowledge-version pa-4">v1.0.0</div>
    </div>
</MudDrawer>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }
}