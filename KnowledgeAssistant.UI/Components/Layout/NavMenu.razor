<MudDrawer @bind-Open="Open"
           Variant="DrawerVariant.Responsive"
           Elevation="0"
           Color="Color.Primary">
    <MudDrawerHeader Style="height: 100px;">

    </MudDrawerHeader>

    <MudNavMenu Class="knowledge-nav">
        <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit">
            Dashboard
        </MudNavLink>

        <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat" IconColor="Color.Inherit">
            Chat
        </MudNavLink>

        <MudNavLink Href="/documents" Icon="@Icons.Material.Filled.Description" IconColor="Color.Inherit">
            Documents
        </MudNavLink>

        <MudNavLink Href="/knowledge" Icon="@Icons.Material.Filled.Person" IconColor="Color.Inherit">
            My Profile
        </MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }
}