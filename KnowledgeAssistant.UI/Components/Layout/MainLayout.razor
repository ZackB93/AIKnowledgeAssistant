@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <Banner OnMenuClick="ToggleDrawer" />
    <NavMenu @bind-Open="_drawerOpen" />

    <MudMainContent Class="knowledge-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6" Style="margin-top: 30px;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#194A8C",
            Secondary = "#FF4081",
            AppbarBackground = "#194A8C"
        },

        PaletteDark = new PaletteDark()
        {
            Primary = "#90CAF9",
            Secondary = "#F48FB1"
        }
    };
}