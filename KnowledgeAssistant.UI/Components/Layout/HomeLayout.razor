@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#194A8C",    
            Secondary = "#FF4081",
            AppbarBackground = "#194A8C"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#90CAF9",
            Secondary = "#F48FB1"
        }
    };
}