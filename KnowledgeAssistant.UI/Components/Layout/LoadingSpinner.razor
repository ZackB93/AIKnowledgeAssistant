<div class="d-flex flex-column align-center justify-center" style="@ContainerStyle">
    <MudProgressCircular Style=@($"color: {Color}") Size="Size" Indeterminate="true" />
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <MudText Typo="Typo.body2" Class="mt-3" Style=@($"color: {Color}")>@Text</MudText>
    }
</div>

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string Color { get; set; } = "#ffffff";

    [Parameter]
    public Size Size { get; set; } = Size.Large;

    [Parameter]
    public string MinHeight { get; set; } = "200px";

    [Parameter]
    public bool FullSize { get; set; } = false;

    private string ContainerStyle => FullSize
        ? "width: 100%; height: 100%;"
        : $"min-height: {MinHeight};";
}
