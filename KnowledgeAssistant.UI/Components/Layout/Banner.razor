@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<MudAppBar Elevation="0" Class="knowledge-appbar" Dense="false">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Class="mobile-menu-button" 
                   aria-label="Toggle navigation"
                   @onclick="OnMenuClick" />

    <MudSpacer />

    <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone"
                   Color="Color.Inherit"
                   Class="ml-2"
                   aria-label="Notifications" />

    <MudDivider Vertical="true" FlexItem="true" Class="mx-3" Style="color: #E4E7EB;" />

    <div class="user-menu">
        <button type="button" class="user-menu-trigger" @onclick="ToggleUserMenu">

            <MudAvatar Size="Size.Small" Color="Color.Secondary">
                @userInitials
            </MudAvatar>

            <span class="user-menu-name">
                @userName
            </span>

            <MudIcon Icon="@Icons.Material.Filled.ExpandMore"
                     Size="Size.Small"
                     Class="user-menu-icon" />
        </button>

        @if (IsUserMenuOpen)
        {
            <div class="user-menu-dropdown" @onclick="ToggleUserMenu">
                <a href="/profile" class="user-menu-item">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    <span>My profile</span>
                </a>

                <div class="user-menu-divider"></div>

                <button type="button" class="user-menu-item" @onclick="OnSignOut">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                    <span>Sign out</span>
                </button>
            </div>
        }
    </div>
</MudAppBar>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    [Parameter]
    public EventCallback OnMenuClick { get; set; }

    private string _searchTerm = string.Empty;
    private string userName = string.Empty;
    private string userInitials = string.Empty;

    private bool IsUserMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        userName = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity?.Name ?? "Unknown user";
        userInitials = GetUserInitials(userName);
    }

    private void ToggleUserMenu()
    {
        IsUserMenuOpen = !IsUserMenuOpen;
    }

    private string GetUserInitials(string name)
    {
        var parts = name
            .Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(n => char.IsLetter(n[0]))
            .ToArray();

        if (parts.Length == 0)
        {
            return string.Empty;
        }

        var initials = parts.Length == 1
            ? parts[0][0].ToString()
            : $"{parts[0][0]}{parts[^1][0]}";

        return initials.ToUpperInvariant();
    }

    private async Task OnSignOut()
    {
        Navigation.NavigateTo("/Account/Logout", forceLoad: true);
    }
}