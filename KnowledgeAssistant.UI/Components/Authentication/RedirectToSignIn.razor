@inject NavigationManager NavigationManager

@code
{
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        var error = Uri.EscapeDataString("Session has timed out");

        NavigationManager.NavigateTo($"/signin?returnUrl={returnUrl}&error={error}", forceLoad: true);
    }
}