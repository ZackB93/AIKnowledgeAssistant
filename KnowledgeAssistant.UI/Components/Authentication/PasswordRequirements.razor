<div class="d-flex flex-column gap-1">
    @foreach (var requirement in Requirements)
    {
        <div class="d-flex align-center">
            <MudIcon Icon="@(requirement.IsMet ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                     Color="@(requirement.IsMet ? Color.Success : Color.Error)"
                     Size="Size.Small"
                     Class="mr-2" />
            <MudText Typo="Typo.body2" Color="@(requirement.IsMet ? Color.Success : Color.Error)">
                @requirement.Text
            </MudText>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Password { get; set; } = string.Empty;

    private List<(string Text, bool IsMet)> Requirements => new()
    {
        ("Must be atleast 8 characters", Password.Length >= 8),
        ("Must contain atleast 1 number", Password.Any(char.IsDigit)),
        ("Must contain atleast 1 capital ", Password.Any(char.IsUpper)),
        ("Must contain atleast 1 special character", Password.Any(c => !char.IsLetterOrDigit(c))),
    };
}