@page "/signin"
@layout HomeLayout
@attribute [AllowAnonymous]

<PageTitle>Knowledge Assistant - Sign In</PageTitle>

<SignInForm error="@error" returnUrl="@returnUrl" />

@code{
    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? error { get; set; }
}