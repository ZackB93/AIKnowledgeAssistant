@page "/chat"
@attribute [Authorize]
@implements IAsyncDisposable

@using System.Net.Http.Headers
@using KnowledgeAssistant.Application.DTOs.Chat
@using KnowledgeAssistant.Application.DTOs.Documents
@using KnowledgeAssistant.Application.Entities.Documents
@using KnowledgeAssistant.Application.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor


<PageTitle>Knowledge Assistant - Chat</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudPaper Class="chat-container pa-4 glass-card">
        <MudGrid Spacing="0" Class="chat-grid">

            <!-- Chat Sessions -->
            <MudItem xs="12" sm="4" md="3" Class="chat-sidebar" Style="border-right: solid 1px rgba(255, 255, 255, 0.3);">
                <div class="chat-sidebar-header">
                    <MudText Typo="Typo.h6">
                        Chats
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="CreateNewChat"
                                   Disabled="@creatingSession" />
                </div>

                @if (loadingSessions)
                {
                    <div class="pa-4 d-flex justify-center">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                else if (sessions.Count == 0)
                {
                    <div class="pa-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No conversations yet.
                        </MudText>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Class="mt-3"
                                   OnClick="CreateNewChat">
                            New Chat
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudList T="ChatSessionResponse" Dense="true">

                        @foreach (var session in sessions)
                        {
                              <MudListItem T="ChatSessionResponse"
                                        Value="@session"
                                        Class="@(session.Id == selectedSession?.Id ? "chat-session selected" : "chat-session")"
                                        OnClick="@(() => SelectSession(session))">

                             <div class="chat-session-content">
                                    <MudIcon Icon="@Icons.Material.Filled.Chat"
                                             Size="Size.Small"
                                             Class="chat-session-icon" />

                                    <MudText>
                                        @session.Title
                                    </MudText>
                                </div>

                            </MudListItem>
                        }

                    </MudList>
                }
            </MudItem>

            <!-- Chat -->
            <MudItem xs="12" sm="8" md="9" Class="chat-main">

                @if (selectedSession == null)
                {
                    <div class="chat-empty-state">

                        <MudIcon Icon="@Icons.Material.Filled.SmartToy"
                                 Size="Size.Large"
                                 Color="Color.Primary" />

                        <MudText Typo="Typo.h5" Class="mt-3">
                            Knowledge Assistant
                        </MudText>

                        <MudText Typo="Typo.body1"
                                 Color="Color.Secondary"
                                 Class="mt-2">
                            Select a conversation or start a new one.
                        </MudText>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Class="mt-4"
                                   OnClick="CreateNewChat">
                            New Chat
                        </MudButton>

                    </div>
                }
                else
                {
                    <!-- Chat header -->
                    <div class="chat-header">
                        <div>
                            <MudText Typo="Typo.h6">
                                @(selectedSession.Title ?? "New Chat")  - @selectedSession.CreatedAt.ToString("dd/MM/yyyy HH:mm tt")
                            </MudText>

                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(messages.Count) messages
                            </MudText>
                        </div>
                    </div>

                    <!-- Messages -->
                    <div class="chat-messages" id="chat-messages">

                        @if (loadingMessages)
                        {
                            <div class="d-flex justify-center pa-6">
                                <MudProgressCircular Indeterminate="true"
                                                     Color="Color.Primary" />
                            </div>
                        }
                        else if (messages.Count == 0)
                        {
                            <div class="chat-empty-messages">
                                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                         Size="Size.Large"
                                         Color="Color.Primary" />

                                <MudText Typo="Typo.body1" Class="mt-2">
                                    Start a conversation
                                </MudText>

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">
                                    Ask Knowledge Assistant a question below.
                                </MudText>
                            </div>
                        }
                        else
                        {
                            @foreach (var message in messages)
                            {
                                var isUser = message.Role.Equals("user", StringComparison.OrdinalIgnoreCase);

                                <div class="message-row @(isUser ? "user-message" : "assistant-message")">
                                    <div class="message-bubble">
                                        <MudText Typo="Typo.body1"
                                                 Class="message-content">
                                            @message.Content
                                        </MudText>

                                        <div class="message-footer">
                                            <MudText Typo="Typo.caption"
                                                     Class="message-time">
                                                @message.CreatedAt.ToLocalTime().ToString("HH:mm")
                                            </MudText>

                                            @if (!isUser)
                                            {
                                                <div class="message-actions">
                                                    <MudTooltip Text="@(copiedMessageId == message.Id ? "Copied" : "Copy")">
                                                        <MudIconButton Icon="@(copiedMessageId == message.Id
                                                                        ? Icons.Material.Filled.Check
                                                                        : Icons.Material.Outlined.ContentCopy)"
                                                                       Size="Size.Small"
                                                                       Class="message-action-button"
                                                                       OnClick="@(() => CopyMessage(message))" />
                                                    </MudTooltip>

                                                    <MudTooltip Text="Regenerate">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                                                       Size="Size.Small"
                                                                       Class="message-action-button"
                                                                       Disabled="@sendingMessage"
                                                                       OnClick="@(() => RegenerateMessage(message))" />
                                                    </MudTooltip>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (sendingMessage)
                            {
                                <div class="message-row assistant-message">
                                    <div class="message-bubble typing-bubble">
                                        <MudProgressCircular Indeterminate="true"
                                                             Size="Size.Small"
                                                             Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Class="ml-2">
                                            Thinking...
                                        </MudText>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                    
                    <!-- Message input -->
                    <div class="chat-input">
                        @if (pendingFiles.Count > 0 || uploadError is not null)
                        {
                            <div class="attachment-bar">
                                @foreach (var file in pendingFiles)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Outlined.Description"
                                             OnClose="@(() => RemovePendingFile(file))">
                                        @file.Name
                                    </MudChip>
                                }

                                @if (uploadError is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@uploadError</MudText>
                                }
                            </div>
                        }

                        <div class="emoji-input-wrapper">
                            @if (emojiPickerOpen)
                            {
                                <div class="emoji-picker">
                                    <div class="emoji-picker-header">
                                        <MudText Typo="Typo.subtitle2">Choose an emoji</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(() => emojiPickerOpen = false)" />
                                    </div>

                                    <div class="emoji-grid">
                                        @foreach (var emoji in Emojis)
                                        {
                                            <button type="button"
                                                    class="emoji-button"
                                                    title="@emoji"
                                                    @onclick="() => InsertEmoji(emoji)">
                                                @emoji
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="attach-wrapper">
                                <MudIconButton Icon="@Icons.Material.Outlined.AttachFile"
                                               Color="Color.Default"
                                               Size="Size.Medium"
                                               Title="Attach document"
                                               Disabled="@sendingMessage" />

                                @if (!sendingMessage)
                                {
                                    <InputFile @key="fileInputKey"
                                               class="attach-input"
                                               accept=".pdf,.docx,.txt,.md"
                                               multiple
                                               OnChange="OnFilesSelected" />
                                }
                            </div>

                            <MudIconButton Icon="@Icons.Material.Outlined.EmojiEmotions"
                                           Color="Color.Default"
                                           Size="Size.Medium"
                                           Disabled="@sendingMessage"
                                           OnClick="ToggleEmojiPicker" />

                            <MudTextField @bind-Value="messageText"
                                          Placeholder="Ask Knowledge Assistant..."
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          Lines="2"
                                          Immediate="true"
                                          Disabled="@sendingMessage"
                                          OnKeyDown="HandleKeyDown"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Send"
                                          AdornmentColor="Color.Primary"
                                          OnAdornmentClick="SendMessage" />
                        </div>
                    </div>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {

    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject] 
    private IScrollManager ScrollManager { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private IJSObjectReference? chatModule;

    private List<ChatSessionResponse> sessions = new();
    private List<ChatMessageResponse> messages = new();
    private List<IBrowserFile> pendingFiles = new();

    private ChatSessionResponse? selectedSession;

    private long? copiedMessageId;
    private int fileInputKey;

    private bool loadingSessions;
    private bool loadingMessages;
    private bool creatingSession;
    private bool sendingMessage;
    private bool scrollToBottom;
    private bool emojiPickerOpen;
    private bool uploadingDocument;

    private string? uploadError;
    private string messageText = string.Empty;

    private const long MaxUploadBytes = 10 * 1024 * 1024;
    private const int MaxPendingFiles = 5;
    private static readonly string[] AllowedExtensions = [".pdf", ".docx", ".txt", ".md"];

    private readonly string[] Emojis =
    [
        "😀", "😃", "😄", "😁", "😆", "😅", "😂", "🤣",
        "😊", "😇", "🙂", "🙃", "😉", "😍", "🥰", "😘",
        "😎", "🤔", "🤨", "😐", "🙄", "😴", "😭", "😡",
        "👍", "👎", "👌", "👏", "🙏", "💪", "🤝", "🙌",
        "❤️", "💙", "💚", "💯", "🔥", "✨", "🎉", "🚀",
        "💡", "⭐", "☕", "🎯", "✅", "❌", "🤖", "💻"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadChatSessionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chatModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
        }

        if (scrollToBottom && chatModule is not null)
        {
            scrollToBottom = false;
            await chatModule.InvokeVoidAsync("scrollToBottom", "chat-messages");
        }
    }

    private async Task LoadChatSessionsAsync()
    {
        loadingSessions = true;

        var result = await HttpService.GetDataAsync("/Chat/GetChatSessionsByUserId");

        if (result is not null && result.IsSuccessful)
        {
            var sessionsResponse = result.GetData<List<ChatSessionResponse>>();

            if (sessionsResponse is not null)
            {
                sessions = sessionsResponse;
            }
        }

        loadingSessions = false;   

        // Automatically select the first chat
        if (sessions.Count > 0)
        {
            await SelectSession(sessions[0]);
        }
    }

    private async Task SelectSession(ChatSessionResponse session)
    {
        if(selectedSession?.Id == session.Id)
        {       
            return;
        }

        selectedSession = session;
        messages = [];
        pendingFiles = [];
        uploadError = null;

        await LoadMessagesAsync(session.Id);
    }

    private async Task LoadMessagesAsync(int sessionId)
    {
        loadingMessages = true;

        var result = await HttpService.GetDataAsync($"/Chat/GetChatMessagesBySessionId/{sessionId}");

        if (result is not null && result.IsSuccessful)
        {
            var allMessages = result.GetData<List<ChatMessageResponse>>();

            if (allMessages is not null)
            {
                messages = allMessages;
            }
        }

        scrollToBottom = true;
        loadingMessages = false;

        StateHasChanged();
    }

    private async Task CreateNewChat()
    {
        if (creatingSession)
        {
            return;
        }

        creatingSession = true;

        var request = new AddChatSessionRequest
        {
            Title = "New Chat"
        };

        var result = await HttpService.PostDataAsync("/Chat/AddSession", request);

        if (result is not null && result.IsSuccessful)
        {
            var session = result.GetData<ChatSessionResponse>();

            if (session is not null)
            {
                sessions.Insert(0, session);
                await SelectSession(session);
            }
        }

        creatingSession = false;       
    }

    private async Task SendMessage()
    {
        if (sendingMessage || selectedSession is null || string.IsNullOrWhiteSpace(messageText))
        {
            return;
        }

        var message = messageText.Trim();
        var filesToUpload = pendingFiles.ToList();

        messageText = string.Empty;
        pendingFiles = [];
        uploadError = null;
        sendingMessage = true;

        // Add user's message to UI immediately
        var userMessage = new ChatMessageResponse
        {
            ChatSessionId = selectedSession.Id,
            Role = "user",
            Content = message,
            CreatedAt = DateTime.UtcNow
        };

        messages.Add(userMessage);
        scrollToBottom = true;
        StateHasChanged();

        // Upload attachments first so their chunks exist before the AI answers.
        foreach (var file in filesToUpload)
        {
            var document = await UploadFileAsync(file, selectedSession.Id);

            if (document is null)
            {
                // Roll back: restore the text and files so the user can retry.
                messages.Remove(userMessage);
                messageText = message;
                pendingFiles = filesToUpload;
                sendingMessage = false;
                StateHasChanged();
                return;
            }
        }

        var request = new AddChatMessageRequest
        {
            ChatSessionId = selectedSession.Id,
            Content = message
        };

        var result = await HttpService.PostDataAsync("/Chat/AddMessage", request);

        if (result is not null && result.IsSuccessful)
        {
            var response = result.GetData<ChatMessageResponse>();

            if (response is not null)
            {
                messages.Add(response);

                if (response.NewTitle is not null)
                {
                    selectedSession.Title = response.NewTitle;
                }

                scrollToBottom = true;
            }
        }

        sendingMessage = false;
        StateHasChanged();
    }

    private async Task RegenerateMessage(ChatMessageResponse message)
    {
        if (sendingMessage || selectedSession is null)
        {
            return;
        }

        sendingMessage = true;
        scrollToBottom = true;

        StateHasChanged();

        var request = new RegenerateMessageRequest()
        {
            ChatMessageId = message.Id,
            ChatSessionId = selectedSession.Id
        };

        var result = await HttpService.PostDataAsync("/Chat/RegenerateMessage", request);

        if (result is not null && result.IsSuccessful)
        {
            var response = result.GetData<ChatMessageResponse>();

            if (response is not null)
            {
                var messageIndex = messages.FindIndex(x => x.Id == message.Id);

                if (messageIndex >= 0)
                {
                    messages[messageIndex] = response;
                }
            }
        }

        sendingMessage = false;

        StateHasChanged();
    }

    private async Task<DocumentResponse?> UploadFileAsync(IBrowserFile file, int sessionId)
    {
        try
        {
            using var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(file.OpenReadStream(MaxUploadBytes));

            fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);

            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent(sessionId.ToString()), "chatSessionId");

            var result = await HttpService.PostFileAsync("/Document/Upload", content);

            if (result.IsSuccessful)
            {
                return result.GetData<DocumentResponse>();
            }

            uploadError = $"{file.Name}: {result.Message ?? "upload failed."}";
        }
        catch (Exception)
        {
            uploadError = $"{file.Name}: upload failed.";
        }

        return null;
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;

        foreach (var file in e.GetMultipleFiles(MaxPendingFiles))
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();

            if (!AllowedExtensions.Contains(extension))
            {
                uploadError = $"{file.Name}: unsupported file type.";
                continue;
            }

            if (file.Size > MaxUploadBytes)
            {
                uploadError = $"{file.Name}: file is too large (max 10 MB).";
                continue;
            }

            if (pendingFiles.Count >= MaxPendingFiles)
            {
                uploadError = $"You can attach up to {MaxPendingFiles} files.";
                break;
            }

            pendingFiles.Add(file);
        }

        // A fresh input lets the user pick the same file again after removing it.
        fileInputKey++;
    }

    private void RemovePendingFile(IBrowserFile file)
    {
        pendingFiles.Remove(file);
        uploadError = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await SendMessage();
        }
    }
    
    private void InsertEmoji(string emoji)
    {
        messageText += emoji;
        emojiPickerOpen = false;
    }

    private void ToggleEmojiPicker()
    {
        emojiPickerOpen = !emojiPickerOpen;
    }

    private async Task CopyMessage(ChatMessageResponse message)
    {
        if (string.IsNullOrWhiteSpace(message.Content))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", message.Content);

        copiedMessageId = message.Id;

        StateHasChanged();

        await Task.Delay(1500);

        if (copiedMessageId == message.Id)
        {
            copiedMessageId = null;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (chatModule is not null)
        {
            try
            {
                await chatModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Blazor Server circuit already closed, safe to ignore
            }
        }
    }
}