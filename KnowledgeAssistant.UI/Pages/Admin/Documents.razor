@using KnowledgeAssistant.Application.DTOs.API
@using KnowledgeAssistant.Application.DTOs.Documents
@using KnowledgeAssistant.Application.Services

@page "/documents"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Knowledge Assistant - Documents</PageTitle>

<MudContainer>
    <MudPaper Class="pa-4 glass-card">

        <MudText Typo="Typo.h5" Class="mb-2">System Documents</MudText>

                <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="false"
                   StartIcon="@Icons.Material.Filled.AddCircle"
                   Size="Size.Small"
                   OnClick="() => ToggleUploadDocumentModal()"
                   Class="mb-2">

            <MudText>Upload Document</MudText>
        </MudButton>

        <MudStack Row="true" Spacing="1" Class="mb-2">
            <MudTextField T="string"
                          Value="@SearchTerm"
                          ValueChanged="@(value => SearchTermChanged(value))"
                          Placeholder="Search document"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Size="Size.Small"
                           OnClick="ClearSearch">

                    Clear
                </MudButton>
            }
        </MudStack>

        <MudTable @ref="Table"
                  ServerData="LoadDocuments"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Uploaded By</MudTh>
                <MudTh>Uploaded Date</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>  
                <MudTd DataLabel="Name">@context.FileName</MudTd>  
                <MudTd DataLabel="Uploaded By">@context.UserName</MudTd>  
                <MudTd DataLabel="Uploaded Date">@context.CreatedAt.ToString("dd/MM/yyyy HH:mm tt")</MudTd>  
                <MudTd DataLabel="Type">@context.ContentType</MudTd>  
                <MudTd DataLabel="Size">@DocumentResponse.FormatFileSize(context.SizeBytes)</MudTd>  
                <MudTd DataLabel="Status">@context.Status</MudTd>  
            </RowTemplate>

            <LoadingContent>
                <div class="d-flex justify-center table-state-bg">
                    <LoadingSpinner />
                </div>
            </LoadingContent>

            <NoRecordsContent>
                <MudText Class="table-state-bg">
                    No documents found
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>
</MudContainer>

<Modal @bind-Visible="@(UploadDocumentModalVisible)"
       Title="Upload Documents"
       ShowCloseButton="true">

       <FileUploader OnUploadComplete="() => OnUploadComplete()" />

</Modal>

@code
{
    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private MudTable<DocumentResponse>? Table;
    private bool UploadDocumentModalVisible = false;
    private string SearchTerm = string.Empty;
    private CancellationTokenSource? SearchCancellationTokenSource;

    private async Task SearchTermChanged(string Value)
    {
        SearchTerm = Value;

        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
        SearchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, SearchCancellationTokenSource.Token);

            if (Table is not null)
            {
                await Table.ReloadServerData();
            }
        }
        catch (TaskCanceledException)
        {
            // A new character was typed before the 400ms delay completed.
        }
    }

    private async Task ClearSearch()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchTerm = string.Empty;

        if (Table is not null)
        {
            await Table.ReloadServerData();
        }
    }

    private async Task<TableData<DocumentResponse>> LoadDocuments(TableState State, CancellationToken CancellationToken)
    {
        var PageNumber = State.Page + 1;
        var PageSize = State.PageSize;

        var Response = string.IsNullOrWhiteSpace(SearchTerm)
            ? await HttpService.GetDataAsync($"/Document/GetAll?PageNumber={PageNumber}&PageSize={PageSize}",
                CancellationToken: CancellationToken)
            : await HttpService.GetDataAsync($"/Document/Search?SearchTerm={Uri.EscapeDataString(SearchTerm)}&PageNumber={PageNumber}&PageSize={PageSize}",
                CancellationToken: CancellationToken);

        if (Response.IsSuccessful && Response.Data is not null)
        {
            var PaginatedResponse = Response.GetData<PaginatedResponse<DocumentResponse>>();

            return new TableData<DocumentResponse>
            {
                Items = PaginatedResponse?.Items,
                TotalItems = PaginatedResponse!.TotalCount
            };
        }

        Snackbar.Add("An error has occurred loading documents!", Severity.Error);

        return new TableData<DocumentResponse>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private void ToggleUploadDocumentModal()
    {
        UploadDocumentModalVisible = !UploadDocumentModalVisible;
    }

    private async Task OnUploadComplete()
    {
        await Table!.ReloadServerData();
        UploadDocumentModalVisible = false;
    }

    public void Dispose()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
    }
}