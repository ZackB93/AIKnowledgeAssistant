@using System.ComponentModel.DataAnnotations
@using KnowledgeAssistant.Application.DTOs.Cache
@using KnowledgeAssistant.Application.DTOs.Roles
@using KnowledgeAssistant.Application.Services

@page "/admin/roles"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Knowledge Assistant - Roles</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4 glass-card">

        <MudText Typo="Typo.h5" Class="mb-2">System Roles</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="false"
                   StartIcon="@Icons.Material.Filled.AddCircle"
                   Size="Size.Small"
                   OnClick="() => ToggleRoleModal(new(){ Id = -1 })"
                   Class="mb-2">

            <MudText>Add New Role</MudText>
        </MudButton>

        <MudTable @ref="Table"
                  ServerData="LoadRoles"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>

                <MudTd DataLabel="Created">
                    @context.CreatedDateTime.ToString("dd/MM/yyyy hh:mm tt")
                </MudTd>

                <MudTd DataLabel="Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Description">
                    @context.Description
                </MudTd>

                <MudTd>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="false"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="() => ToggleRoleModal(context)"
                               Size="Size.Small">

                        <MudText>Edit</MudText>
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <LoadingContent>
                <div class="d-flex justify-center table-state-bg">
                    <LoadingSpinner />
                </div>
            </LoadingContent>

            <NoRecordsContent>
                <MudText Class="table-state-bg">
                    No roles found
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>
</MudContainer>

<Modal @bind-Visible="@(RoleModalVisible)" Title=@(SelectedRole?.Id == -1 ? "Add New Role" : "Edit Role") ShowCloseButton="true">
    @if (SelectedRole is not null)
    {
        <MudForm @ref="_form" Model="_viewModel" Validation="@_validator.ValidateValue">

            <MudTextField @bind-Value="_viewModel.Name"
                          For="@(() => _viewModel.Name)"
                          Label="Role Name"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="_viewModel.Description"
                          For="@(() => _viewModel.Description)"
                          Label="Description"
                          Variant="Variant.Outlined" />
        </MudForm>

       <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@Saving">
                <MudText>@(SelectedRole.Id == -1 ? "Create Role" : "Save Changes")</MudText>
            </MudButton>
       </MudStack>
    }
</Modal>

@code
    {
    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private ICacheService CacheService { get; set; } = null!;

    private MudTable<RoleResponse>? Table;
    private RoleResponse? SelectedRole;
    private bool RoleModalVisible = false;
    private bool Saving = false;

    private MudForm _form = null!;
    private readonly RoleViewModelValidator _validator = new();
    private RoleViewModel _viewModel = new();

    private async Task<TableData<RoleResponse>> LoadRoles(TableState state, CancellationToken ct)
    {
        var cache = new Cache { CacheKey = "Roles", CacheTimeMins = 30 };
        var response = await HttpService.GetDataAsync("/Role/GetAll", CacheData: cache, ct: ct);

        if (response.IsSuccessful && response.Data is not null)
        {
            var roles = response.GetData<List<RoleResponse>>() ?? new();

            return new TableData<RoleResponse>
            {
                Items = roles,
                TotalItems = roles.Count
            };
        }

        Snackbar.Add("An error occurred loading roles!", Severity.Error);

        return new TableData<RoleResponse>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private async Task Save()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            Snackbar.Add("Please populate any required fields!", Severity.Error);
            return;
        }

        Saving = true;

        var Response = SelectedRole?.Id == -1 ? 
            await HttpService.PostDataAsync("/Role/Create", MapToCreateModel(_viewModel)) :
            await HttpService.PostDataAsync("/Role/Update", MapToUpdateModel(_viewModel));

        if (Response.IsSuccessful && Response.Data is not null)
        { 
            var Role = Response.GetData<RoleResponse>()!;

            _viewModel = MapToViewModel(Role);
            CacheService.RemoveFromCache("roles");

            await OnRoleSaved();

            Snackbar.Add("Successfully saved!", Severity.Success);
        }
        else
        { 
            Snackbar.Add("An error occurred whilst saving!", Severity.Error);
        }

        Saving = false;
    }

    private void ToggleRoleModal(RoleResponse? Role)
    {
        if(Role is not null)
        {
             _viewModel = MapToViewModel(Role);
        }

        SelectedRole = Role;
        RoleModalVisible = !RoleModalVisible;
    }

    private async Task OnRoleSaved()
    {
        await Table!.ReloadServerData();

        RoleModalVisible = false;
        SelectedRole = null;
    }

    private static RoleViewModel MapToViewModel(RoleResponse dto) => new()
    {
        Id = dto.Id,
        Name = dto.Name,
        Description = dto.Description,
        CreatedDateTime = dto.CreatedDateTime
    };

    private static UpdateRoleRequest MapToUpdateModel(RoleViewModel model) => new()
    {
        Id = model.Id,
        Name = model.Name,
        Description = model.Description,
    };

    private static CreateRoleRequest MapToCreateModel(RoleViewModel model) => new()
    {
        Name = model.Name,
        Description = model.Description,
    };

    private class RoleViewModelValidator
    {
        public IEnumerable<string> ValidateValue(object model, string propertyName)
        {
            var property = model.GetType().GetProperty(propertyName);
            if (property is null)
            {
                return Enumerable.Empty<string>();
            }

            var value = property.GetValue(model);
            var context = new ValidationContext(model)
            {
                MemberName = propertyName
            };

            var results = new List<ValidationResult>();
            Validator.TryValidateProperty(value, context, results);

            return results.Select(r => r.ErrorMessage ?? "Invalid value");
        }
    }

    private class RoleViewModel
    {
        public int Id {get; set;} 

        [Required(ErrorMessage = "Role name is required.")]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public DateTime CreatedDateTime { get; set; }
    }
}