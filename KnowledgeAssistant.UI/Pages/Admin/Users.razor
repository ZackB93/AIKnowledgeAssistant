@using KnowledgeAssistant.Application.DTOs.API
@using KnowledgeAssistant.Application.DTOs.Users
@using KnowledgeAssistant.Application.Services
@using KnowledgeAssistant.UI.Components.User

@page "/users"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>Knowledge Assistant - Users</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4 glass-card">

        <MudText Typo="Typo.h5" Class="mb-2">System Users</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="false"
                   StartIcon="@Icons.Material.Filled.AddCircle"
                   Size="Size.Small"
                   OnClick="() => ToggleUserModal(new(){ Id = -1})"
                   Class="mb-2">

            <MudText>Add New User</MudText>
        </MudButton>

        <MudStack Row="true" Spacing="1" Class="mb-2">
            <MudTextField T="string"
                          Value="@SearchTerm"
                          ValueChanged="@(value => SearchTermChanged(value))"
                          Placeholder="Search user with name or email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Size="Size.Small"
                           OnClick="ClearSearch">

                    Clear
                </MudButton>
            }
        </MudStack>

        <MudTable @ref="Table"
                  ServerData="LoadUsers"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Full Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Enabled</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Created">@context.CreatedDateTime.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                <MudTd DataLabel="Full Name">@context.FirstName @context.LastName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Enabled">@context.Enabled</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="false"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="() => ToggleUserModal(context)"
                               Size="Size.Small">

                        <MudText>Edit</MudText>
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <LoadingContent>
                <div class="d-flex justify-center table-state-bg">
                    <LoadingSpinner />
                </div>
            </LoadingContent>

            <NoRecordsContent>
                <MudText Class="table-state-bg">
                    No users found
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>
</MudContainer>

<Modal @bind-Visible="@(UserModalVisible)"
       Title=@(SelectedUser?.Id == -1 ? "Add New User" : "Edit User")
       ShowCloseButton="true">

    @if (SelectedUser is not null)
    {
        <Details UserId="@SelectedUser.Id" AllowBorder="false" OnUserSaved="() => OnUserSaved()" />
    }
</Modal>

@code
{
    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private MudTable<UserResponse>? Table;
    private UserResponse? SelectedUser = null;
    private bool UserModalVisible = false;
    private string SearchTerm = string.Empty;
    private CancellationTokenSource? SearchCancellationTokenSource;

    private async Task SearchTermChanged(string Value)
    {
        SearchTerm = Value;

        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
        SearchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, SearchCancellationTokenSource.Token);

            if (Table is not null)
            {
                await Table.ReloadServerData();
            }
        }
        catch (TaskCanceledException)
        {
            // A new character was typed before the 400ms delay completed.
        }
    }

    private async Task ClearSearch()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchTerm = string.Empty;

        if (Table is not null)
        {
            await Table.ReloadServerData();
        }
    }

    private async Task<TableData<UserResponse>> LoadUsers(TableState State, CancellationToken ct)
    {
        var PageNumber = State.Page + 1;
        var PageSize = State.PageSize;

        var Response = string.IsNullOrWhiteSpace(SearchTerm)
            ? await HttpService.GetDataAsync($"/User/GetAll?PageNumber={PageNumber}&PageSize={PageSize}",
                ct: ct)
            : await HttpService.GetDataAsync($"/User/Search?SearchTerm={Uri.EscapeDataString(SearchTerm)}&PageNumber={PageNumber}&PageSize={PageSize}",
                ct: ct);

        if (Response.IsSuccessful && Response.Data is not null)
        {
            var PaginatedResponse = Response.GetData<PaginatedResponse<UserResponse>>();

            return new TableData<UserResponse>
            {
                Items = PaginatedResponse?.Items,
                TotalItems = PaginatedResponse!.TotalCount
            };
        }

        Snackbar.Add("An error has occurred loading users!", Severity.Error);

        return new TableData<UserResponse>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private async Task OnUserSaved()
    {
        await Table!.ReloadServerData();
        UserModalVisible = false;
        SelectedUser = null;
    }

    private void ToggleUserModal(UserResponse? user)
    {
        SelectedUser = user;
        UserModalVisible = !UserModalVisible;
    }

    public void Dispose()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
    }
}
