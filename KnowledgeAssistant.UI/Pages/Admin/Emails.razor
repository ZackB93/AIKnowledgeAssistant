@using KnowledgeAssistant.Application.DTOs.API
@using KnowledgeAssistant.Application.DTOs.Emails
@using KnowledgeAssistant.Application.Services
@using KnowledgeAssistant.Domain.Enums

@page "/admin/emails"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>Knowledge Assistant - Emails</PageTitle>

<MudContainer>
    <MudPaper Class="pa-4 glass-card">

        <MudText Typo="Typo.h5" Class="mb-2">System Emails</MudText>

        <MudStack Row="true" Spacing="1" Class="mb-2">
            <MudTextField T="string"
                          Value="@SearchTerm"
                          ValueChanged="@(value => SearchTermChanged(value))"
                          Placeholder="Search email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Size="Size.Small"
                           OnClick="ClearSearch">

                    Clear
                </MudButton>
            }
        </MudStack>

        <MudTable @ref="Table"
                  ServerData="LoadEmails"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Bordered="true">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>User</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Subject</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created At</MudTh>
                <MudTh>Sent At</MudTh>
                <MudTh>Failed At</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>  
                <MudTd DataLabel="User">@context.UserName</MudTd>
                <MudTd DataLabel="To">@context.To</MudTd>
                <MudTd DataLabel="Subject">@context.Subject</MudTd>
                <MudTd DataLabel="Status">@context.Status</MudTd>
                <MudTd DataLabel="Created At">@context.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                <MudTd DataLabel="Sent At">@context.SentAt?.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                <MudTd DataLabel="Failed At">@context.FailedAt?.ToString("dd/MM/yyyy hh:mm tt")</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="false"
                               StartIcon="@Icons.Material.Filled.RemoveRedEye"
                               OnClick="() => ToggleEmailModal(context)"
                               Size="Size.Small">

                        <MudText>Details</MudText>
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <LoadingContent>
                <div class="d-flex justify-center table-state-bg">
                    <LoadingSpinner />
                </div>
            </LoadingContent>

            <NoRecordsContent>
                <MudText Class="table-state-bg">
                    No emails found
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>
</MudContainer>

<Modal @bind-Visible="@EmailModalVisible"
       Title="@(SelectedEmail?.Subject ?? "Email details")"
       ShowCloseButton="true">

    @if (SelectedEmail is not null)
    {
        var (statusColor, statusIcon) = GetStatusStyle(SelectedEmail.Status);

        <MudPaper Class="email-details glass-card">
            <div class="email-details__main">
                @if (SelectedEmail.IsHtml)
                {
                    <MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" ApplyEffectsToContainer="true">
                        <MudTabPanel Text="Message">
                            <MudPaper Outlined="true" Elevation="0" Class="email-details__body pa-4">
                                @((MarkupString)SelectedEmail.Body)
                            </MudPaper>
                        </MudTabPanel>

                        <MudTabPanel Text="HTML source">
                            <MudPaper Outlined="true" Elevation="0" Class="email-details__body pa-4">
                                <pre class="email-details__source">@SelectedEmail.Body</pre>
                            </MudPaper>
                        </MudTabPanel>
                    </MudTabs>
                }
                else
                {
                    <MudPaper Outlined="true" Elevation="0" Class="email-details__body pa-4 mt-2">
                        <pre class="email-details__plain">@SelectedEmail.Body</pre>
                    </MudPaper>
                }

                @if (!string.IsNullOrEmpty(SelectedEmail.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        @SelectedEmail.ErrorMessage
                    </MudAlert>
                }
            </div>

            <aside class="email-details__side">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                    <div>
                        <MudChip T="string" Size="Size.Small" Color="@statusColor" Icon="@statusIcon" Class="ma-0">
                            @SelectedEmail.Status
                        </MudChip>
                    </div>
                </div>

                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">To</MudText>
                    <MudText Typo="Typo.body2" Style="word-break: break-all;">@SelectedEmail.To</MudText>
                </div>

                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Subject</MudText>
                    <MudText Typo="Typo.body2">@SelectedEmail.Subject</MudText>
                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedEmail.UserName))
                {
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Requested by</MudText>
                        <MudText Typo="Typo.body2">@SelectedEmail.UserName</MudText>
                    </div>
                }

                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                    <MudText Typo="Typo.body2">@FormatDate(SelectedEmail.CreatedAt)</MudText>
                </div>

                @if (SelectedEmail.SentAt is not null)
                {
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sent</MudText>
                        <MudText Typo="Typo.body2">@FormatDate(SelectedEmail.SentAt.Value)</MudText>
                    </div>
                }

                @if (SelectedEmail.FailedAt is not null)
                {
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Failed</MudText>
                        <MudText Typo="Typo.body2">@FormatDate(SelectedEmail.FailedAt.Value)</MudText>
                    </div>
                }

                @if (SelectedEmail.RetryCount > 0)
                {
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Retries</MudText>
                        <MudText Typo="Typo.body2">@SelectedEmail.RetryCount</MudText>
                    </div>
                }

                <MudButton Variant="Variant.Filled"
                           Color="@Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyBodyAsync"
                           Class="mt-auto">
                    Copy body
                </MudButton>
            </aside>
        </MudPaper>
    }
</Modal>

@code
    {
    [Inject]
    private IHttpService HttpService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private MudTable<EmailResponse>? Table;
    private EmailResponse? SelectedEmail = null;
    private bool EmailModalVisible = false;
    private string SearchTerm = string.Empty;
    private CancellationTokenSource? SearchCancellationTokenSource;

    private static string FormatDate(DateTime value) => value.ToString("dd MMM yyyy, HH:mm");

    private async Task SearchTermChanged(string Value)
    {
        SearchTerm = Value;

        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
        SearchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, SearchCancellationTokenSource.Token);

            if (Table is not null)
            {
                await Table.ReloadServerData();
            }
        }
        catch (TaskCanceledException)
        {
            // A new character was typed before the 400ms delay completed.
        }
    }

    private static (Color Color, string Icon) GetStatusStyle(EmailStatus status)
    {
        var name = status.ToString().ToLowerInvariant();

        if (name.Contains("fail") || name.Contains("error"))
            return (Color.Error, Icons.Material.Filled.ErrorOutline);

        if (name.Contains("sent") || name.Contains("deliver"))
            return (Color.Success, Icons.Material.Filled.Check);

        if (name.Contains("pending") || name.Contains("queue") || name.Contains("retry") || name.Contains("sending"))
            return (Color.Warning, Icons.Material.Filled.Schedule);

        return (Color.Default, Icons.Material.Filled.Mail);
    }

    private async Task ClearSearch()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchTerm = string.Empty;

        if (Table is not null)
        {
            await Table.ReloadServerData();
        }
    }

    private async Task<TableData<EmailResponse>> LoadEmails(TableState State, CancellationToken ct)
    {
        var PageNumber = State.Page + 1;
        var PageSize = State.PageSize;

        var Response = string.IsNullOrWhiteSpace(SearchTerm)
            ? await HttpService.GetDataAsync($"/Email/GetAll?PageNumber={PageNumber}&PageSize={PageSize}",
                ct: ct)
            : await HttpService.GetDataAsync($"/Email/Search?SearchTerm={Uri.EscapeDataString(SearchTerm)}&PageNumber={PageNumber}&PageSize={PageSize}",
                ct: ct);

        if (Response.IsSuccessful && Response.Data is not null)
        {
            var PaginatedResponse = Response.GetData<PaginatedResponse<EmailResponse>>();

            return new TableData<EmailResponse>
            {
                Items = PaginatedResponse?.Items,
                TotalItems = PaginatedResponse!.TotalCount
            };
        }

        Snackbar.Add("An error has occurred loading emails!", Severity.Error);

        return new TableData<EmailResponse>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private async Task CopyBodyAsync()
    {
        if (!string.IsNullOrEmpty(SelectedEmail?.Body))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", SelectedEmail.Body);
        }
    }

    private async Task OnUserSaved()
    {
        await Table!.ReloadServerData();
        EmailModalVisible = false;
        SelectedEmail = null;
    }

    private void ToggleEmailModal(EmailResponse? email)
    {
        SelectedEmail = email;
        EmailModalVisible = !EmailModalVisible;
    }

    public void Dispose()
    {
        SearchCancellationTokenSource?.Cancel();
        SearchCancellationTokenSource?.Dispose();
    }
}