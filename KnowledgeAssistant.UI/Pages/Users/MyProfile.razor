@using System.Security.Claims
@using KnowledgeAssistant.UI.Components.User
@using Microsoft.AspNetCore.Components.Authorization

@page "/profile"
@attribute [Authorize]

<PageTitle>Knowledge Assistant - Profile</PageTitle>

<Details userId="userId" />

@code {
    [Inject]
    private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    private int? userId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claimValue = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        userId = int.TryParse(claimValue, out var id) ? id : null;
    }
}